{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "tactics",
    "techniques",
    "subtechniques",
    "attack_confidence",
    "mapping_reasons"
  ],
  "properties": {
    "tactics": { "type": "array", "items": { "type": "string" } },
    "techniques": { "type": "array", "items": { "type": "string" } },
    "subtechniques": { "type": "array", "items": { "type": "string" } },
    "attack_confidence": { "type": "number" },
    "mapping_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
